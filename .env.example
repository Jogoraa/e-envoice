# ==============================================================================
# UT INVOICE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Authoritative Compliance: FDRE Ministry of Revenue Directive No. 1142/2026
# ==============================================================================

# Database Connection (PostgreSQL 15+)
DATABASE_URL=jdbc:postgresql://localhost:5432/ut_einvoice_db
DATABASE_USERNAME=ut_einvoice_user
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Security & JWT Engine (Key must be at least 256-bit cryptographically secure secret)
PLATFORM_JWT_SECRET=CHANGE_ME_MINIMUM_256_BIT_SECRET_KEY_FOR_JWT_SIGNING
PLATFORM_JWT_ISSUER=ut-einvoice-platform
PLATFORM_JWT_AUDIENCE=ut-invoice-tenant

# Ministry of Revenue (MoR) EIRS Gateway Ingress Configuration
MOR_GATEWAY_URL=https://core.mor.gov.et
MOR_CLIENT_ID=CHANGE_ME_MOR_CLIENT_ID
MOR_CLIENT_SECRET=CHANGE_ME_MOR_CLIENT_SECRET
MOR_API_KEY=CHANGE_ME_MOR_API_KEY
MOR_SELLER_TIN=CHANGE_ME_SELLER_TIN
MOR_SYSTEM_NUMBER=CHANGE_ME_SYSTEM_NUMBER
MOR_SYSTEM_TYPE=POS

# Multi-Tenant Control Plane Settings
PLATFORM_SHARD_NAME=shared_cluster
PLATFORM_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.utsolutionsplc.com

# Offline Resilience & Buffer
OFFLINE_BUFFER_MAX_AGE_HOURS=72
OFFLINE_SEQUENCE_ALLOCATION_CHUNK=500
