# ==============================================================================
# UT Electronic Invoicing Platform — Environment Configuration Template
# Directive No. 1142/2026 Compliant Multi-Tenant SaaS Platform
# ==============================================================================

# Application & Profiles
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Primary PostgreSQL 16 Cluster (Hot Transactional Tier)
DB_URL=jdbc:postgresql://localhost:5432/ut_einvoice_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_POOL_MAX=20

# Redis 7 (Distributed Locking & Idempotency)
REDIS_HOST=localhost
REDIS_PORT=6379

# Ministry of Revenues (MoR) Electronic Invoice Registration System (EIRS) Gateway
MOR_GATEWAY_URL=http://core.mor.gov.et
MOR_CLIENT_ID=your-mor-client-id
MOR_CLIENT_SECRET=your-mor-client-secret
MOR_API_KEY=your-mor-api-key
MOR_SELLER_TIN=0041746204
MOR_SYSTEM_NUMBER=8EFBBDD7FF
MOR_SYSTEM_TYPE=POS

# INSA Digital Signature & Cryptographic Keystore (Bouncy Castle)
INSA_KEYSTORE_PATH=/etc/ut/keys/keystore.p12
INSA_KEYSTORE_PASSWORD=keystorepassword
INSA_CERT_ALIAS=ut-insa-signing-cert

# MinIO / S3 Object Storage (Invoice PDFs, Receipt Documents & Exports)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=ut-invoices-documents
S3_BUCKET_EXPORTS=ut-invoices-exports

# Compliance SLA Deadlines (Directive Art. 23(4) & Art. 26(3))
OFFLINE_RECONCILIATION_SLA_HOURS=72
CANCELLATION_EVIDENCE_SLA_HOURS=48
