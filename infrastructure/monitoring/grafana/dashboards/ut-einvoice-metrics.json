{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Certified Invoices Throughput (TPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{uri=~\"/api/v1/invoices.*\", status=\"201\"}[1m])",
          "legendFormat": "Invoices Registered / s"
        }
      ]
    },
    {
      "title": "API Request Latency (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)"
        }
      ]
    },
    {
      "title": "JVM Active Heap Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"} / (1024 * 1024)",
          "legendFormat": "Used Heap (MB)"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"} / (1024 * 1024)",
          "legendFormat": "Max Heap (MB)"
        }
      ]
    },
    {
      "title": "Outbox Event Dispatch & Queue Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(outbox_events_dispatched_total[1m]))",
          "legendFormat": "Outbox Relay Rate"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["einvoice", "compliance", "production"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "UT Electronic Invoicing Platform Telemetry",
  "version": 1
